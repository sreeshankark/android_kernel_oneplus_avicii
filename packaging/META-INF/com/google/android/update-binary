fi;
sleep 0.5s;
dyui_print " ";
sleep 0.033333s;
ui_print "|---------------------------------------------|";
sleep 0.033333s;
sleep 1s;
dyui_print " ";
dyui_print "- Install NeverSettle Kernel";
sleep 1s;
dyui_print "-> Extracting boot.img";
sleep 2s;
